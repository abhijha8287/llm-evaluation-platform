# Copy to .env and fill in. Never commit the real .env.

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/llm_eval
REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=change-me-to-a-real-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# D2: rate limit on the trigger-run endpoint, independent of auth state
MAX_RUNS_PER_DAY=3

# D9/D6/Constraints: fixed, separate judge model for every response,
# regardless of which provider generated it (avoids self-preference bias).
JUDGE_MODEL=gpt-4o-mini

# Provider keys — server-side only, never accepted from request bodies.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
DEEPSEEK_API_KEY=

DEFAULT_SAMPLE_SIZE=25

# Phase 9: port the Celery worker's own Prometheus /metrics server binds to
# (separate from FastAPI's /metrics — see app/monitoring/metrics.py).
CELERY_METRICS_PORT=9808
